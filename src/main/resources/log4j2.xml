<Configuration monitorInterval="5">
	<Appenders>
		<Console name="Console">
			<PatternLayout pattern="%-5p [%t] %c{1.} %M - %m%n" />
			>
		</Console>
	</Appenders>
	<Loggers>
		<Logger name="Musician_0" level="trace" additivity="false">
			<AppenderRef ref="Console" />
		</Logger>
<!-- 		<Logger name="Musician_13" level="debug" additivity="false"> -->
<!-- 			<AppenderRef ref="Console" /> -->
<!-- 		</Logger> -->
		<Logger name="org.roach.margia.rules.StateBasedRule" level="info" additivity="false">
			<AppenderRef ref="Console" />
		</Logger>
		<Logger name="org.roach.margia.Transport" level="info"
			additivity="false">
			<AppenderRef ref="Console" />
		</Logger>
		<Logger name="org.roach.margia.MidiController" level="debug"
			additivity="false">
			<AppenderRef ref="Console" />
		</Logger>
		<Root level="info">
			<AppenderRef ref="Console" />
		</Root>
	</Loggers>
</Configuration>