<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonType?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<fx:root type="javafx.scene.control.DialogPane"
	prefHeight="650.0" prefWidth="940.0" xmlns="http://javafx.com"
	xmlns:fx="http://javafx.com">
	<content>
		<VBox spacing="8.0">
			<padding>
				<Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
			</padding>
			<children>
				<SplitPane dividerPositions="0.1" orientation="HORIZONTAL"
					VBox.vgrow="ALWAYS">
					<items>
						<!-- Left Sidebar: Rules & Templates -->
						<VBox spacing="8.0">
							<padding>
								<Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
							</padding>
							<children>
								<Label style="-fx-font-weight: bold;"
									text="Rules &amp; Templates" />
								<ListView fx:id="ruleListView" VBox.vgrow="ALWAYS" />
								<Button fx:id="newBtn" maxWidth="1.7976931348623157E308"
									onAction="#onNewBlankClicked" text="New Blank" />
								<Button fx:id="deleteBtn"
									maxWidth="1.7976931348623157E308"
									onAction="#onDeleteSelectedClicked" text="Delete Selected" />
								<!-- Inside the left sidebar VBox in RuleEditorDialog.fxml -->
								<Label style="-fx-font-weight: bold;"
									text="Rules &amp; Templates" />
								<ListView fx:id="ruleListView" VBox.vgrow="ALWAYS" />
								<Button fx:id="newBtn" maxWidth="1.7976931348623157E308"
									onAction="#onNewBlankClicked" text="New Blank" />
								<Button fx:id="deleteBtn"
									maxWidth="1.7976931348623157E308"
									onAction="#onDeleteSelectedClicked" text="Delete Selected" />
								<Button fx:id="importBtn"
									maxWidth="1.7976931348623157E308" onAction="#onImportClicked"
									text="Import YAML..." />
								<Button fx:id="exportBtn"
									maxWidth="1.7976931348623157E308" onAction="#onExportClicked"
									text="Export YAML..." />
							</children>
						</VBox>

						<!-- Right Editor Pane -->
						<VBox spacing="10.0">
							<padding>
								<Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
							</padding>
							<children>
								<!-- Rule Metadata -->
								<GridPane hgap="10.0" vgap="8.0">
									<columnConstraints>
										<ColumnConstraints minWidth="75.0" />
										<ColumnConstraints hgrow="SOMETIMES"
											minWidth="160.0" />
										<ColumnConstraints minWidth="90.0" />
										<ColumnConstraints hgrow="SOMETIMES"
											minWidth="160.0" />
									</columnConstraints>
									<rowConstraints>
										<RowConstraints />
									</rowConstraints>
									<children>
										<Label text="Rule Name:" GridPane.columnIndex="0"
											GridPane.rowIndex="0" />
										<TextField fx:id="ruleNameField"
											promptText="e.g., myCustomRule" GridPane.columnIndex="1"
											GridPane.rowIndex="0" />
										<Label text="Starting State:" GridPane.columnIndex="2"
											GridPane.rowIndex="0" />
										<ComboBox fx:id="startingStateCombo" editable="true"
											maxWidth="1.7976931348623157E308"
											promptText="Starting state name" GridPane.columnIndex="3"
											GridPane.rowIndex="0" />
									</children>
								</GridPane>

								<!-- Editor Tabs -->
								<TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE"
									VBox.vgrow="ALWAYS">
									<tabs>
										<!-- Tab 1: Visual Form Builder -->
										<Tab fx:id="visualTab" text="Visual Builder">
											<content>
												<SplitPane dividerPositions="0.32"
													orientation="VERTICAL">
													<items>
														<VBox spacing="8.0">
															<padding>
																<Insets bottom="8.0" left="8.0" right="8.0"
																	top="8.0" />
															</padding>
															<children>
																<Label style="-fx-font-weight: bold;"
																	text="Configurable UI Properties (referenced via $key)" />
																<ListView fx:id="propListView"
																	VBox.vgrow="ALWAYS" />
																<Button onAction="#onAddPropertyClicked"
																	text="+ Add Property" />
															</children>
														</VBox>
														<VBox spacing="8.0">
															<padding>
																<Insets bottom="8.0" left="8.0" right="8.0"
																	top="8.0" />
															</padding>
															<children>
																<Label style="-fx-font-weight: bold;"
																	text="States, Actions &amp; Transitions" />
																<ListView fx:id="stateListView"
																	VBox.vgrow="ALWAYS" />
																<Button onAction="#onAddStateClicked"
																	text="+ Add State" />
															</children>
														</VBox>
													</items>
												</SplitPane>
											</content>
										</Tab>

										<!-- Tab 2: Interactive State Graph -->
										<Tab fx:id="graphTab" text="State Graph">
											<content>
												<BorderPane fx:id="graphHostPane" />
											</content>
										</Tab>

										<!-- Tab 3: Raw YAML Source -->
										<Tab fx:id="yamlTab" text="YAML Source">
											<content>
												<TextArea fx:id="yamlEditorArea"
													style="-fx-font-family: 'monospaced'; -fx-font-size: 12px;" />
											</content>
										</Tab>
									</tabs>
								</TabPane>

								<!-- Action Toolbar -->
								<HBox spacing="10.0">
									<padding>
										<Insets top="4.0" />
									</padding>
									<children>
										<Button onAction="#onValidateClicked" text="Validate" />
										<Button fx:id="saveBtn" onAction="#onSaveClicked"
											style="-fx-font-weight: bold;" text="Save &amp; Apply Live" />
										<Button fx:id="saveAsBtn" onAction="#onSaveAsClicked"
											text="Save As..." />
									</children>
								</HBox>
							</children>
						</VBox>
					</items>
				</SplitPane>

				<!-- Status Feedback Line -->
				<Label fx:id="statusLabel" />
			</children>
		</VBox>
	</content>
	<buttonTypes>
		<ButtonType fx:constant="CLOSE" />
	</buttonTypes>
</fx:root>
