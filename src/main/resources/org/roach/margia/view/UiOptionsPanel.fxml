<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.SpinnerValueFactory.DoubleSpinnerValueFactory?>
<?import javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.control.ColorPicker?>

<fx:root type="javafx.scene.layout.VBox"
	styleClass="options-section" xmlns="http://javafx.com"
	xmlns:fx="http://javafx.com">

	<Label text="UI Options" fx:id="titleLabel"
		styleClass="section-title" />

	<GridPane hgap="8.0" vgap="6.0">
		<columnConstraints>
			<ColumnConstraints percentWidth="30.0" />
			<ColumnConstraints percentWidth="70.0" />
		</columnConstraints>
		<rowConstraints>
			<RowConstraints />
			<RowConstraints />
			<RowConstraints />
			<RowConstraints />
			<RowConstraints />
			<RowConstraints />
			<RowConstraints />
		</rowConstraints>

		<!-- Row 0: Gravitational Constant -->
		<Label text="Gravitational Constant" labelFor="$gravity"
			GridPane.columnIndex="0" GridPane.rowIndex="0" />
		<Spinner fx:id="gravity" id="Gravity" editable="true"
			GridPane.columnIndex="1" GridPane.rowIndex="0">
			<valueFactory>
				<SpinnerValueFactory.DoubleSpinnerValueFactory
					min="-20.0" max="20.0" amountToStepBy="0.1" />
			</valueFactory>
		</Spinner>

		<!-- Row 1: Wind Speed -->
		<Label text="WindSpeed" labelFor="$windSpeed"
			GridPane.columnIndex="0" GridPane.rowIndex="1" />
		<Spinner fx:id="windSpeed" id="Wind speed (clockwise)"
			editable="true" GridPane.columnIndex="1" GridPane.rowIndex="1">
			<valueFactory>
				<SpinnerValueFactory.DoubleSpinnerValueFactory
					min="-200.0" max="200.0" amountToStepBy="0.1" />
			</valueFactory>
		</Spinner>

		<!-- Row 2: Edge Length -->
		<Label text="Edge length" labelFor="$edgeLength"
			GridPane.columnIndex="0" GridPane.rowIndex="2" />
		<Spinner fx:id="edgeLength" id="edgeLength" editable="true"
			GridPane.columnIndex="1" GridPane.rowIndex="2">
			<valueFactory>
				<SpinnerValueFactory.IntegerSpinnerValueFactory
					min="20" max="300" amountToStepBy="1" />
			</valueFactory>
		</Spinner>

		<!-- Row 3: Show Icons -->
		<CheckBox fx:id="showIcons" text="Show icons"
			GridPane.columnIndex="1" GridPane.rowIndex="3">
			<tooltip>
				<Tooltip
					text="Show/hide additional information on musicians" />
			</tooltip>
		</CheckBox>

		<!-- Row 4: Animate Background -->
		<CheckBox fx:id="animateBackground" text="Animate background"
			GridPane.columnIndex="1" GridPane.rowIndex="4">
			<tooltip>
				<Tooltip text="Animate background" />
			</tooltip>
		</CheckBox>

		<!-- Row 5: RippleExpansionSpeed -->
		<Label text="Ripple Expansion Speed"
			labelFor="$rippleExpansionSpeed" GridPane.columnIndex="0"
			GridPane.rowIndex="5" />
		<Spinner fx:id="rippleExpansionSpeed"
			id="rippleExpansionSpeed" editable="true" GridPane.columnIndex="1"
			GridPane.rowIndex="5">
			<valueFactory>
				<SpinnerValueFactory.DoubleSpinnerValueFactory
					min="0.1" max="300.0" amountToStepBy="0.1" />
			</valueFactory>
			<tooltip>
				<Tooltip text="Speed at which ripples grow" />
			</tooltip>
		</Spinner>

		<!-- Row 6: Max active ripples -->
		<Label text="Max active ripples" labelFor="$maxActiveRipples"
			GridPane.columnIndex="0" GridPane.rowIndex="6" />
		<Spinner fx:id="maxActiveRipples" id="maxActiveRipples"
			editable="true" GridPane.columnIndex="1" GridPane.rowIndex="6">
			<valueFactory>
				<SpinnerValueFactory.IntegerSpinnerValueFactory
					min="1" max="300" amountToStepBy="1" />
			</valueFactory>
			<tooltip>
				<Tooltip
					text="Maximum number of active ripples across all musicians" />
			</tooltip>
		</Spinner>

		<!-- Row 7: RippleScreenFraction -->
		<Label text="Ripple Screen Fraction"
			labelFor="$rippleScreenFraction" GridPane.columnIndex="0"
			GridPane.rowIndex="7" />
		<Spinner fx:id="rippleScreenFraction"
			id="rippleScreenFraction" editable="true" GridPane.columnIndex="1"
			GridPane.rowIndex="7">
			<valueFactory>
				<SpinnerValueFactory.DoubleSpinnerValueFactory
					min="0.01" max="1.0" amountToStepBy="0.01" />
			</valueFactory>
			<tooltip>
				<Tooltip
					text="Fraction of the screen that ripples are allowed to grow before dissipating" />
			</tooltip>
		</Spinner>

		<!-- Row 7: Color picker -->
		<Label text="Background Color" labelFor="$colorPicker"
			GridPane.columnIndex="0" GridPane.rowIndex="8" />
		<ColorPicker fx:id="colorPicker" GridPane.columnIndex="1"
			GridPane.rowIndex="8">
			<tooltip>
				<Tooltip text="Background color" />
			</tooltip>
		</ColorPicker>
	</GridPane>
</fx:root>
